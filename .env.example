# Neon connection string (Dashboard > Connection details). Leave unset to use local SQLite.
DATABASE_URL=postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Optional: route requests through a proxy if a site blocks your runner's IP.
PROXY_URL=
# Pages per section per run (~25 ads each) and pause between pages, in seconds.
MAX_PAGES=40
REQUEST_DELAY=3
